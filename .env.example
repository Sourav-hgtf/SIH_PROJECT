# SIH HSE/HSSE Analytics Environment Configuration

# Application Environment (development | staging | production)
APP_ENV=development

# Demo Mode (true | false). When true in development, demo users and sample reports are seeded.
DEMO_MODE=true

# Security Secrets (MUST be changed in production)
SECRET_KEY=dev-sif-sentinel-change-in-production-secret-key-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection
DATABASE_URL=sqlite:///./sif_sentinel.db

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SIF Analytics Thresholds & Limits
SIF_THRESHOLD=0.45
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_ROWS=5000

# Model Artifact & Manifest Paths
MODEL_MANIFEST_PATH=data/model_artifacts/model_manifest.json
